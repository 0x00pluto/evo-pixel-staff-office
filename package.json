{
  "name": "evo-agent-team",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "bin": {
    "pixel-office": "./bin/pixel-office.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:office": "EVO_AGENT_CATALOG=\"${EVO_AGENT_CATALOG:-$HOME/Documents/Codex/AgentWikiIndex/CATALOG.json}\" vite --force",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pixel-office": "node ./bin/pixel-office.mjs",
    "gen:assets": "node ./scripts/pack-external-tilesets.mjs && node ./scripts/gen-pixel-assets.mjs",
    "sync:map-palette": "node ./scripts/sync-map-palette.mjs",
    "import:wa-company": "node ./scripts/import-wa-starter-company.mjs",
    "import:wa-world": "node ./scripts/import-wa-village-world.mjs",
    "annotate:collides": "node ./scripts/annotate-collides.mjs",
    "pack:tilesets": "node ./scripts/pack-external-tilesets.mjs",
    "unpack:tilesets": "node ./scripts/unpack-external-tilesets.mjs",
    "pack:assets": "node ./scripts/pack-office-assets.mjs"
  },
  "dependencies": {
    "open": "^11.0.2",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
